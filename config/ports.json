{
  "development": {
    "services": [
      {
        "service": "flutter-dev-server",
        "defaultPort": 5176,
        "range": [5173, 5180],
        "description": "Flutter web development server",
        "required": true,
        "env": "FLUTTER_WEB_PORT"
      },
      {
        "service": "python-ai-service",
        "defaultPort": 5050,
        "range": [5050, 5060],
        "description": "Python AI service for document analysis and OCR",
        "required": false,
        "env": "PYTHON_AI_SERVICE_PORT"
      }
    ]
  },
  "test": {
    "services": [
      {
        "service": "flutter-dev-server",
        "defaultPort": 5176,
        "range": [5173, 5180],
        "description": "Flutter web dev server (integration tests)",
        "required": false,
        "env": "FLUTTER_WEB_PORT"
      }
    ]
  },
  "production": {
    "services": [
      {
        "service": "python-ai-service",
        "defaultPort": 5050,
        "range": [5050, 5060],
        "description": "Python AI service for document analysis",
        "required": false,
        "env": "PYTHON_AI_SERVICE_PORT"
      }
    ]
  }
}
